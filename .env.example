# Kannada Kaliyiri Environment Configuration
# Copy this file to .env.local for local development.

# --- AI Chatbot with Neela (One-on-One Tutoring) ---
# Add your Gemini API key (recommended, free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: GEMINI_MODEL=gemini-2.5-flash

# Or Anthropic Claude API key:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: AI_PROVIDER=gemini

# --- Supabase (Optional: Cloud Save & Leaderboard) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
