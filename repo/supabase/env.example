# Copy these two lines into a file named .env.local in the project root (never commit it),
# and add the same two variables in Vercel/Netlify: Project > Settings > Environment Variables.
# Find them in Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: turn on "Chat with Neela" (server-side only, do NOT prefix with NEXT_PUBLIC_).
# GEMINI_API_KEY=YOUR-KEY
# ANTHROPIC_API_KEY=YOUR-KEY
